{
  "defaults": {
    "windows": { "os": "Windows" },
    "mac": { "os": "Mac" },
    "linux": { "os": "Linux" }
  },
  "_hint": "more inventories: drop *.json into ~/.rrun/machines.d/ (see its README.md); docs: https://github.com/waqiju/rrun",
  "machines": [
    {
      "name": "my-win-box",
      "ip": "192.168.1.10",
      "os": "Windows",
      "user": "admin",
      "password": "secret",
      "description": "Windows build box"
    },
    {
      "name": "my-mac-mini",
      "hostname": "mac-mini.local",
      "ip": "192.168.1.20",
      "os": "Mac",
      "user": "admin",
      "password": "secret"
    },
    {
      "name": "my-linux",
      "ip": "192.168.1.30",
      "os": "Linux",
      "user": "ubuntu",
      "password": "secret",
      "python": "/usr/bin/python3.12"
    },
    {
      "name": "cloud-vm-key-auth",
      "ip": "1.2.3.4",
      "port": 2222,
      "os": "Linux",
      "user": "root",
      "identity_file": "~/.ssh/id_ed25519",
      "description": "password omitted -> key auth (BatchMode); port overrides 22"
    }
  ]
}
